    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
        public let {{ method.parameters.first.name }}: {{ method.parameters.first.typeName }}
    }
    public func {{ method.name }} {
        self.onRefresh = [{{ method.parameters.first.name }}]
        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            {{ method.parameters.first.name }}: {{ method.parameters.first.name }}
        )
    }
    {% elif type.name == "RefreshControlOutput" and method.parameters.count == 1 and method.parameters.first.name == "appendingOnRefresh" %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
        public let {{ method.parameters.first.name }}: {{ method.parameters.first.typeName }}
    }
    public func {{ method.name }} {
        var callbacks = self.onRefresh ?? []
        callbacks.append({{ method.parameters.first.name }})
        self.onRefresh = callbacks
        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            {{ method.parameters.first.name }}: {{ method.parameters.first.name }}
        )
    }
    {% elif type.name == "PickerViewOutput" and method.parameters.count == 1 and method.parameters.first.name == "model" %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
        public let outputSequence: UInt64
        public let {{ method.parameters.first.name }}: {{ method.parameters.first.typeName }}
    }
    public func {{ method.name }} {
        self.componentsCount = {{ method.parameters.first.name }}?.componentsCount
        self.rowsCount = {{ method.parameters.first.name }}?.rowsCount
        self.titleForRowAt = {{ method.parameters.first.name }}?.titleForRowAt
        self.didSelectAt = {{ method.parameters.first.name }}?.didSelectAt
        nextOutputSequence &+= 1
        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            outputSequence: nextOutputSequence,
            {{ method.parameters.first.name }}: {{ method.parameters.first.name }}
        )
