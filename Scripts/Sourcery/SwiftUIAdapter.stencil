        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            outputSequence: nextOutputSequence,
            {% for param in method.parameters %}
            {{ param.name }}: {{ param.name }}{% if not forloop.last %}, {% endif %}
            {% endfor %}
        )
    }
    {% elif type.implements.HiddableOutput and method.parameters.count == 1 and method.parameters.first.isOptional and (method.parameters.first.name == "model" or method.parameters.first.name == "text" or method.parameters.first.name == "attributes") %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
        public let {{ method.parameters.first.name }}: {{ method.parameters.first.unwrappedTypeName }}
    }
    public func {{ method.name }} {
        guard let {{ method.parameters.first.name }} else {
            display(isHidden: true)
            return
        }
        display(isHidden: false)
        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            {{ method.parameters.first.name }}: {{ method.parameters.first.name }}
        )
