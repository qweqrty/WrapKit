        {% elif variable.isOptional %}
        @Published public var {{ variable.name }}: {{ variable.typeName }} = nil{% if type.name == "ButtonOutput" or type.name == "DatePickerViewOutput" or type.name == "PickerViewOutput" or type.name == "EmptyViewOutput" or type.name == "TitledOutput" or type.name == "RefreshControlOutput" or type.name == "KeyValueFieldViewOutput" or type.name == "ImageViewOutput" or type.name == "ProgressBarOutput" or type.name == "StackViewOutput" or type.name == "SwitchCotrolOutput" or type.name == "TextOutput" or type.name == "TextInputOutput" or type.name == "CardViewOutput" or type.name == "HeaderOutput" or type.name == "SearchBarOutput" %} {
