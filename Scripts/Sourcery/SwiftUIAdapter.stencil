public class {{ type.name }}SwiftUIAdapter{% for associatedType in type.associatedTypes|sortedValuesByKeys %}{% if forloop.first %}<{% endif %}{{ associatedType.name }}: {{ associatedType.typeName }}{% if not forloop.last %}{% if type.associatedTypes.count > 1 %},{% endif %}{% endif %}{% if forloop.last %}>{% endif %}{% endfor %}: ObservableObject, {{ type.name }}{% if type.name == "SwitchCotrolOutput" or type.name == "RefreshControlOutput" %}, LoadingOutput{% endif %} {
    {% for variable in type.variables %}
        {% if type.name == "RefreshControlOutput" and variable.name == "onRefresh" %}
        @Published public var {{ variable.name }}: {{ variable.typeName }} = []
        {% elif variable.isOptional %}
        @Published public var {{ variable.name }}: {{ variable.typeName }} = nil
        {% else %}
        @Published public var {{ variable.name }}: {{ variable.typeName }}
        {% endif %}
    {% endfor %}

    {% if type.name == "SwitchCotrolOutput" or type.name == "RefreshControlOutput" %}
    @Published public var isLoading: Bool? = nil
    {% endif %}

    {% if type.name == "DatePickerViewOutput" or type.name == "PickerViewOutput" or type.name == "EmptyViewOutput" or type.name == "TitledOutput" or type.name == "RefreshControlOutput" %}
    private var nextOutputSequence: UInt64 = 0
    {% endif %}

    {% if type.name == "CommonToastOutput" %}
    enum PendingCommand {
        case display(CommonToast)
        case hide
    }

    private var pendingCommands: [PendingCommand] = []
    @Published var pendingCommandRevision: UInt64 = 0

    func takePendingCommands() -> [PendingCommand] {
        let commands = pendingCommands
        pendingCommands.removeAll(keepingCapacity: true)
        return commands
    }
    {% endif %}

    {% if type.name == "SwitchCotrolOutput" %}
    @Published public var displayIsLoadingState: DisplayIsLoadingState? = nil
    public struct DisplayIsLoadingState {
        public let isLoading: Bool
    }
    public func display(isLoading: Bool) {
        self.isLoading = isLoading
        displayIsLoadingState = .init(isLoading: isLoading)
    }
    {% endif %}

