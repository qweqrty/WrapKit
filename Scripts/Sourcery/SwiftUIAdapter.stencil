    {% if not method.isStatic %}
    @Published public var {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State: {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State? = nil
    {% if type.name == "RefreshControlOutput" and method.parameters.count == 1 and method.parameters.first.name == "model" %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
        public let outputSequence: UInt64
        public let {{ method.parameters.first.name }}: {{ method.parameters.first.typeName }}
    }
    public func {{ method.name }} {
        self.onRefresh = [{{ method.parameters.first.name }}?.onRefresh]
        if let isLoading = {{ method.parameters.first.name }}?.isLoading {
            self.isLoading = isLoading
        }
        nextOutputSequence &+= 1
        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            outputSequence: nextOutputSequence,
            {{ method.parameters.first.name }}: {{ method.parameters.first.name }}
        )
    }
    {% elif type.name == "RefreshControlOutput" and method.parameters.count == 1 and method.parameters.first.name == "style" %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
