    {% elif type.name == "PickerViewOutput" and method.parameters.count == 1 and method.parameters.first.name == "selectedRow" %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
        public let outputSequence: UInt64
        public let selectedRow: PickerViewPresentableModel.SelectedRow?
    }
    public func {{ method.name }} {
        guard let selectedRow,
              let componentsCount = componentsCount?(),
              let rowsCount = rowsCount?(),
              selectedRow.component >= 0,
              selectedRow.component < componentsCount,
              selectedRow.row >= 0,
              selectedRow.row < rowsCount else { return }
        nextOutputSequence &+= 1
        {{ method.callName }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State = .init(
            outputSequence: nextOutputSequence,
            selectedRow: selectedRow
        )
    }
    {% elif (type.name == "LoadingOutput" or type.name == "RefreshControlOutput") and method.parameters.count == 1 and method.parameters.first.name == "isLoading" %}
    public struct {{ method.callName|upperFirstLetter }}{% for param in method.parameters %}{{ param.name|upperFirstLetter }}{% endfor %}State {
